# --- Database (Neon / any Postgres). Get a free one at https://neon.tech ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- SMS provider: console | twilio | webhook ---
# console = print to server logs (for testing, no real SMS)
SMS_PROVIDER=console

# Twilio (if SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_FROM=+1234567890

# Generic webhook provider (if SMS_PROVIDER=webhook) — POSTs JSON {to, message}
# Works with Textware.lk / eSMS / Dialog Ideamart gateways via a small adapter URL
# SMS_WEBHOOK_URL=https://your-sms-gateway.example.com/send
# SMS_WEBHOOK_KEY=secret-key-if-needed

# --- Server ---
PORT=3000
